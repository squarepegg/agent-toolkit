# sdlc.config: per-role models and loop limits. Bash, sourced. A project's file overrides these.
# It is code: only humans edit it. Roles cannot reach it: they run sandboxed, in copies.
# Empty model = pi's default. "provider/model" is accepted (pi --list-models).
# Put the attacker on a different model family from the builder.

SDLC_MODEL_spec=""
SDLC_MODEL_tests=""
SDLC_MODEL_design=""
SDLC_MODEL_judge=""
SDLC_MODEL_build=""
SDLC_MODEL_attack=""
SDLC_MODEL_plant=""

SDLC_THINKING_spec="high"
SDLC_THINKING_tests="high"
SDLC_THINKING_design="medium"
SDLC_THINKING_judge="high"
SDLC_THINKING_build="medium"
SDLC_THINKING_attack="high"
SDLC_THINKING_plant="medium"

# Tool allowlists (pi --tools). The default is read,bash,edit,write,grep,find,ls.
SDLC_TOOLS_spec="read,write,edit,grep,find,ls"
SDLC_TOOLS_judge="read,write,grep,find,ls"
SDLC_TOOLS_plant="read,write,grep,find,ls"

# A custom runner replaces pi for one role. It runs in the role's workspace and gets the role prompt
# plus the task on stdin. Setting it here is the authorisation to run it. CLIs that sandbox
# themselves may need SDLC_SANDBOX_<role>=off (nested sandboxes fail on macOS); the report then
# lists that role as unsandboxed.
# SDLC_RUNNER_attack='codex exec --sandbox workspace-write --skip-git-repo-check -'
# SDLC_SANDBOX_attack=off

# OS sandbox for every role, gate command and repro run: required (default) | auto (unsandboxed with
# a warning if none is available; the report lists those roles) | off.
SDLC_SANDBOX=required
# Extra paths sandboxed processes may read (toolchains outside the defaults).
SDLC_SANDBOX_READ=""
# Network for model roles: all (remote providers) | local (loopback only, e.g. a local model gateway).
# Code under test (gate steps, repros, stub runs) always gets local only.
SDLC_SANDBOX_NET_ROLES="all"
# Referee: a fresh role checks each reproduced finding's test against the spec before it is locked.
SDLC_REFEREE=on
SDLC_MODEL_referee=""
SDLC_THINKING_referee="high"
SDLC_TOOLS_referee="read,write,grep,find,ls"

# Consolidate (speed spec Amendment B): after a fix round passes the gate, a fresh role proposes deterministic checks
# for the reproduced findings; an orchestrator validates them (no model). Accepted rules are only STAGED under
# .sdlc/consolidate/round-N/staged-rules; a human adopts a batch at the end of the run (relock --relayed).
# Needs ast-grep on PATH (npm i -g @ast-grep/cli). Best effort: a failure never fails the run.
SDLC_CONSOLIDATE=on
SDLC_MODEL_consolidate=""
SDLC_THINKING_consolidate="high"
SDLC_TOOLS_consolidate="read,write,grep,find,ls"

# pi isolation: no discovered extensions, skills, templates, context files or MCP. If your model
# provider is an extension, list its path here.
SDLC_PI_BIN="pi"
SDLC_PI_ISOLATE=1
SDLC_PI_EXTENSIONS=""
SDLC_PI_EXTRA_ARGS=""
SDLC_ROLE_TIMEOUT=3600

SDLC_DESIGN=0               # 1 = run the design phase (designer + judge)
SDLC_DESIGN_CANDIDATES=3    # 2..3
SDLC_TESTS_ATTEMPTS=2       # tests-role attempts before the phase is rejected
SDLC_BUILD_MAX_ITERS=4      # builder runs per round before giving up
SDLC_MAX_ROUNDS=3           # attack/fix rounds, 1..3
SDLC_ATTACK_RETRIES=1       # extra attempts when the attacker errors or writes invalid findings
SDLC_REPRO_RUNS=2           # >= 2: a repro must fail on every run, or it is quarantined as flaky
SDLC_REPRO_TIMEOUT=900      # seconds per repro run; a timeout makes the round incomplete, never clean
SDLC_CALIBRATE=auto         # auto: after a dry round, plant bugs and measure the attacker | off
SDLC_MUTATION_HISTORY=1     # 1: build-loop gates reuse Pitest history (needs sdlc.pitestHistory=true); passes confirmed fresh
SDLC_NOTIFY=auto            # auto: a macOS notification when spec/tests/build/attack/calibrate/loop/run stop | off
SDLC_NOTIFY_CMD=""          # instead of the notification: a shell command, given the exit code and message as $1 $2

# Where the tests role's TEST_DEPENDENCIES.txt goes (between the sdlc markers), and in what form.
SDLC_TEST_DEP_FILE="build.gradle.kts"
SDLC_TEST_DEP_LINE='testImplementation("%s")'
